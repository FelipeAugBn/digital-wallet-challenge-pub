# Ambiente dos testes de ponta a ponta.
#
# O servidor do E2E sobe com APP_ENV=e2e e o Laravel, ao ver esse valor, carrega
# este arquivo em vez do `.env`. E por aqui, e nao por uma variavel solta na
# linha de comando, que o E2E aponta para o proprio banco: `artisan serve`
# repassa ao servidor apenas uma lista fixa de variaveis, e `DB_DATABASE` nao
# esta nela. APP_ENV esta.
#
# Copie para `.env.e2e` e gere a chave; o `npm run e2e` faz isso sozinho.

APP_NAME="Wallet E2E"
APP_ENV=e2e
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8081

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

# Barato de propósito: o E2E cadastra gente a cada execucao.
BCRYPT_ROUNDS=4

LOG_CHANNEL=stderr
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Um banco so do E2E, apagado e semeado a cada execucao. Nunca `wallet`, que e
# o de desenvolvimento, nem `wallet_testing`, que e o da suite Pest.
DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=wallet_e2e
DB_USERNAME=sail
DB_PASSWORD=password

# Nome proprio para o cookie: e assim que o E2E confere, de dentro do
# navegador, que esta falando com o servidor certo e nao com o de
# desenvolvimento.
SESSION_DRIVER=database
SESSION_COOKIE=wallet_e2e_session
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="wallet@example.com"
MAIL_FROM_NAME="${APP_NAME}"
